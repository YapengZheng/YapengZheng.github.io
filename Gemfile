source "https://rubygems.org"

gem "jekyll", "~> 4.3.0"

# Ruby 3.4 compatibility
gem "csv"
gem "base64"

# Dependencies for jekyll-scholar
gem "bibtex-ruby"
gem "citeproc"
gem "csl"
gem "csl-styles"

# Minimal plugins
group :jekyll_plugins do
    gem "jekyll-scholar"
    gem "jekyll-sitemap"
    gem "jekyll-feed"
end

gem "jekyll-watch", "~> 2.0"
