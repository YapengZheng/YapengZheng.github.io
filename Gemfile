source "https://rubygems.org"

gem "jekyll", "~> 4.3.0"

# Minimal plugins for GitHub Pages
group :jekyll_plugins do
    gem "jekyll-scholar"
    gem "jekyll-sitemap"
    gem "jekyll-feed"
    gem "jekyll-email-protect"
    gem "jekyll-link-attributes"
    gem "jekyll-seo-tag"
    gem "jekyll-toc"
end

# Windows and JRuby compatibility
gem "jekyll-watch", "~> 2.0" unless ENV["CI"]
